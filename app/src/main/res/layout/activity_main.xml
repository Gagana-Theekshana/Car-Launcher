<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLauncherLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:padding="8dp"
    tools:context=".ui.MainActivity">

    <!-- =================================================================== -->
    <!-- TOP STATUS BAR (1024x44dp)                                          -->
    <!-- =================================================================== -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:background="#141C24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Digital Clock -->
        <TextClock
            android:id="@+id/clockWidget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Vehicle Reg & Model Tag -->
        <TextView
            android:id="@+id/tvHeaderRegBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="#1F2937"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="WP CAT 7583 • AQUA NHP10"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Outside & Cabin Temp -->
        <TextView
            android:id="@+id/tvOutsideTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="OUT: 30.0°C  |  CABIN: 26.5°C"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Door Status Warning Pill -->
        <TextView
            android:id="@+id/tvDoorWarningPill"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="#1B3B2B"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="DOORS SECURE"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- GPS Status Badge -->
        <TextView
            android:id="@+id/badgeGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="#1B3B2B"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="GPS: OK"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- CANBUS Status Badge -->
        <TextView
            android:id="@+id/badgeCanbusStatus"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="#263238"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="CANBUS: WAIT"
            android:textColor="#90A4AE"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- OBD2 Status Badge -->
        <TextView
            android:id="@+id/badgeObdStatus"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="#263238"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="OBD2: STBY"
            android:textColor="#90A4AE"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- [SIM MODE] Toggle Button -->
        <Button
            android:id="@+id/btnSimModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="#00E5FF"
            android:minWidth="92dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:text="[SIM MODE: ON]"
            android:textAllCaps="false"
            android:textColor="#0D1117"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- =================================================================== -->
    <!-- VERTICAL GUIDELINES (30% LEFT | 40% CENTER | 30% RIGHT)             -->
    <!-- =================================================================== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight70"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.70" />

    <!-- =================================================================== -->
    <!-- LEFT PANEL (30% WIDTH — DIGITAL INSTRUMENT CLUSTER)                 -->
    <!-- =================================================================== -->
    <LinearLayout
        android:id="@+id/leftClusterPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:background="#141C24"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineLeft30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topStatusBar">

        <!-- Cluster Header: EV / ECO Badges + Gear Selector Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badgeEvMode"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="#00E676"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="EV MODE"
                android:textColor="#0D1117"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeEcoMode"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:background="#1E3A2F"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="ECO"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Interactive Gear Position Strip (Tap to cycle P R N D B) -->
            <TextView
                android:id="@+id/tvGearStrip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="#0D1117"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="P  R  N  [D]  B"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- Huge Digital Speedometer (km/h) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#0D1117"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvSpeedKmh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="64sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActiveGearLarge"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#1C2834"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="#00E5FF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="km/h"
                    android:textColor="#90A4AE"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Engine 1NZ-FXE RPM Progress Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ICE ENGINE RPM"
                    android:textColor="#90A4AE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRpmValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 RPM (EV)"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressRpm"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="3dp"
                android:max="5000"
                android:progress="0"
                android:progressBackgroundTint="#263238"
                android:progressTint="#00E5FF" />
        </LinearLayout>

        <!-- Hybrid HV Battery SOC (%) Progress Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HV BATTERY SOC &amp; TEMP"
                    android:textColor="#90A4AE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHvSocValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="68% • 34.2°C (FAN 2)"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressHvSoc"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="3dp"
                android:max="100"
                android:progress="68"
                android:progressBackgroundTint="#263238"
                android:progressTint="#00E676" />
        </LinearLayout>

        <!-- Powertrain Vital Badges: Coolant Temp + Inverter Temp + Aux 12V Voltage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0D1117"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COOLANT"
                    android:textColor="#90A4AE"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCoolantTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="78°C"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="#0D1117"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INVERTER"
                    android:textColor="#90A4AE"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInverterTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="41°C"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#0D1117"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUX 12V"
                    android:textColor="#90A4AE"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAux12vVolts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14.1V"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Trip & Fuel Economy Card (Fills remaining bottom space of Left Panel) -->
        <LinearLayout
            android:id="@+id/cardActiveTrip"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="#0D1117"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ACTIVE TRIP &amp; ECONOMY"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnResetTripInline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1F2937"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="RESET"
                    android:textColor="#B0BEC5"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISTANCE / TIME"
                        android:textColor="#90A4AE"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvTripDistAndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14.2 km • 23m"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INSTANT / AVG"
                        android:textColor="#90A4AE"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvInstantAndAvgKml"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24.5 / 22.8 km/L"
                        android:textColor="#00E676"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/tvTripCostLkr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COST: LKR 211.75"
                    android:textColor="#FFAB00"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRemainingRangeKm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RANGE: 580 km (72%)"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- =================================================================== -->
    <!-- CENTER PANEL (40% WIDTH — VISUALIZER & MEDIA & AC DRAWER TRIGGER)   -->
    <!-- =================================================================== -->
    <LinearLayout
        android:id="@+id/centerVisualizerPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:background="#141C24"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight70"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft30"
        app:layout_constraintTop_toBottomOf="@id/topStatusBar">

        <!-- Interactive Visualizer Hint Bar + Quick Exterior Lighting Toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TAP DOORS / HOOD / TRUNK TO TEST"
                android:textColor="#90A4AE"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickHeadlights"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="#1F2937"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="HEADLIGHTS"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickFogLights"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="#1F2937"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="FOG LED"
                android:textColor="#B0BEC5"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Top Half: Custom Hardware-Accelerated Toyota Aqua NHP10 Vector Visualizer -->
        <com.aqua.cat7583.launcher.ui.AquaVisualizerView
            android:id="@+id/aquaVisualizerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />

        <!-- Bottom Half 1: Compact Media Controller Strip -->
        <LinearLayout
            android:id="@+id/compactMediaStrip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="#0D1117"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMediaTrackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="XY AUTO BT AUDIO • WP CAT 7583"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMediaArtistSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="DSP Flat • A2DP Connected"
                    android:textColor="#00E5FF"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMediaPrev"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="#1C2834"
                android:text="|&lt;"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMediaPlayPause"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="#00E5FF"
                android:text="PLAY"
                android:textColor="#0D1117"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMediaNext"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="#1C2834"
                android:text="&gt;|"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Half 2: Quick Climate Bar (Tapping opens Full AC Control Dialog) -->
        <LinearLayout
            android:id="@+id/quickClimateBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="#102834"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/btnQuickTempMinus"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="#1C3545"
                android:text="-"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutOpenAcDrawerTrigger"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvQuickAcSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A/C AUTO • TEMP 24.0°C • FAN 3"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuickAcSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MODE: FACE • RECIRC ON (TAP FOR FULL A/C)"
                    android:textColor="#B0BEC5"
                    android:textSize="9sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnQuickTempPlus"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="#1C3545"
                android:text="+"
                android:textColor="#FF1744"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- =================================================================== -->
    <!-- RIGHT PANEL (30% WIDTH — DRIVER QUICK-ACTION GRID 2x3)              -->
    <!-- =================================================================== -->
    <LinearLayout
        android:id="@+id/rightQuickGridPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="8dp"
        android:background="#141C24"
        android:orientation="vertical"
        android:padding="8dp"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineRight70"
        app:layout_constraintTop_toBottomOf="@id/topStatusBar">

        <!-- ROW 1: 1. Navigation | 2. Full AC & Climate Suite -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Tile 1: Navigation (Google Maps / Waze) -->
            <LinearLayout
                android:id="@+id/tileNavigation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0D1117"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAP / GPS"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="NAVIGATION"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Maps / Waze"
                    android:textColor="#90A4AE"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Tile 2: Full AC & Climate Suite -->
            <LinearLayout
                android:id="@+id/tileClimateSuite"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#102430"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CANBUS A/C"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="CLIMATE SUITE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTileClimateSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="24.0°C • Fan 3"
                    android:textColor="#00E5FF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 2: 3. Fuel & LKR Cost Log | 4. Trip & Door Audit History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Tile 3: Fuel & LKR Cost Log -->
            <LinearLayout
                android:id="@+id/tileFuelCostLog"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0D1117"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LKR ECONOMY"
                    android:textColor="#FFAB00"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="FUEL &amp; SERVICE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTileFuelSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="340 LKR/L • Oil"
                    android:textColor="#90A4AE"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Tile 4: Trip & Door Audit History -->
            <LinearLayout
                android:id="@+id/tileTripDoorAudit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#0D1117"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURITY SQLITE"
                    android:textColor="#FF1744"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="TRIP &amp; DOORS"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="GPS Audit Logs"
                    android:textColor="#90A4AE"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 3: 5. CANBUS Hex Sniffer Debugger | 6. All Apps Drawer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Tile 5: CANBUS Hex Sniffer Debugger -->
            <LinearLayout
                android:id="@+id/tileCanbusSniffer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0D1117"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MCU 4.0 X2"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="CANBUS SNIFFER"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTileCanbusHex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="2E 28 05 B8..."
                    android:textColor="#00E676"
                    android:textSize="9sp"
                    android:typeface="monospace" />
            </LinearLayout>

            <!-- Tile 6: All Apps Drawer -->
            <LinearLayout
                android:id="@+id/tileAllAppsDrawer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#0D1117"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANDROID 9.1"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="ALL APPS"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="System Drawer"
                    android:textColor="#90A4AE"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

